{
  "schema_version": 1,
  "profiles": {
    "core": [
      "screenrove",
      "onepagelove",
      "playwright"
    ],
    "research": [
      "screenrove",
      "onepagelove"
    ],
    "testing": [
      "playwright"
    ],
    "colors": [],
    "components": [
      "shadcn",
      "magicui",
      "eased",
      "wensity",
      "heroui",
      "mantine"
    ],
    "all": [
      "screenrove",
      "onepagelove",
      "playwright",
      "shadcn",
      "magicui",
      "eased",
      "wensity",
      "heroui",
      "mantine"
    ]
  },
  "servers": {
    "screenrove": {
      "transport": "http",
      "url": "https://screenrove.com/mcp",
      "homepage": "https://screenrove.com/agents"
    },
    "onepagelove": {
      "transport": "http",
      "url": "https://api.onepagelove.com/mcp",
      "homepage": "https://onepagelove.com/mcp"
    },
    "playwright": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "homepage": "https://github.com/microsoft/playwright-mcp"
    },
    "shadcn": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "homepage": "https://ui.shadcn.com/docs/mcp"
    },
    "magicui": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ],
      "homepage": "https://github.com/magicuidesign/mcp"
    },
    "eased": {
      "transport": "http",
      "url": "https://eased.dev/api/mcp",
      "homepage": "https://github.com/easedui/ui"
    },
    "wensity": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@wensity/mcp@latest"
      ],
      "homepage": "https://ui.wensity.com/docs/mcp"
    },
    "heroui": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@heroui/react-mcp@latest"
      ],
      "homepage": "https://heroui.com/en/docs/react/getting-started/mcp-server"
    },
    "mantine": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mantine/mcp-server"
      ],
      "homepage": "https://mantine.dev/guides/llms/"
    }
  },
  "manual": [
    {
      "name": "Inspo MCP",
      "url": "https://inspomcp.dev/",
      "note": "Installer/packaging differs by client; review upstream before running."
    },
    {
      "name": "VP0 MCP",
      "url": "https://vp0.com/mcp"
    },
    {
      "name": "A1 Gallery MCP",
      "url": "https://www.a1.gallery/mcp"
    },
    {
      "name": "Figma MCP",
      "url": "https://developers.figma.com/docs/figma-mcp-server/"
    },
    {
      "name": "Dart/Flutter MCP",
      "url": "https://docs.flutter.dev/ai/get-started"
    },
    {
      "name": "21st.dev MCP",
      "url": "https://21st.dev/mcp",
      "note": "Needs an API key (x-api-key header on https://21st.dev/api/mcp); official installer: npx @21st-dev/cli@latest init --client claude. AI generation tools need paid AI access."
    },
    {
      "name": "Aceternity UI / Animate UI registries",
      "url": "https://ui.shadcn.com/docs/registry/namespace",
      "note": "No MCP of their own; reached through the shadcn MCP once @aceternity / @animate-ui registries are in the project's components.json. See skills/design-mcp-orchestration/references/component-libraries.md."
    },
    {
      "name": "Color Theory MCP",
      "url": "https://github.com/JoshuaRamirez/color-theory-mcp"
    },
    {
      "name": "Coolors MCP",
      "url": "https://github.com/x51xxx/coolors-mcp"
    },
    {
      "name": "Color Palette Extractor MCP",
      "url": "https://github.com/aka-kika/color-palette-extractor-mcp"
    },
    {
      "name": "Colors & Fonts MCP",
      "url": "https://www.colorsandfonts.com/mcp/"
    },
    {
      "name": "RNV Color MCP",
      "url": "https://github.com/RNVizion/rnv-color-mcp"
    }
  ]
}
